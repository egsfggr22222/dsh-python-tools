def file_stamp(path: str) -> float:
    """文件的修改时间；不存在就是 0。"""
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0.0


def watch_file(path: str, on_change: "Callable[[float], None]", *, interval: float = 0.4,
               should_stop: "Callable[[], bool]" = None) -> None:
    """盯一个文件的变化，变了就调 on_change(新mtime)。阻塞运行，自己开线程用。

    基线取启动时刻的 mtime —— 上一次会话遗留的文件不会被当成“刚发生”。
    """
    seen = file_stamp(path)
    while True:
        if should_stop is not None and should_stop():
            return
        time.sleep(max(0.05, float(interval)))
        stamp = file_stamp(path)
        if stamp > seen:
            seen = stamp
            try:
                on_change(stamp)
            except Exception:
                pass


def wait_until(check: "Callable[[], bool]", *, timeout: float = 60.0,
               interval: float = 0.08) -> bool:
    """等一个条件成立。超时返回 False。"""
    deadline = time.time() + max(0.0, float(timeout))
    while time.time() < deadline:
        try:
            if check():
                return True
        except Exception:
            pass
        time.sleep(max(0.01, float(interval)))
    try:
        return bool(check())
    except Exception:
        return False

_OWNER_FILES: "Dict[str, str]" = {}


def _caller_file(depth: int = 2) -> str:
    """声明所在的源文件：相对于被解释的文件本身，而不是本库。"""
    try:
        frame = sys._getframe(depth)
    except (AttributeError, ValueError):
        frame = None
    while frame is not None:
        filename = frame.f_code.co_filename
        if filename and os.path.abspath(filename) != os.path.abspath(__file__):
            return os.path.abspath(filename)
        frame = frame.f_back
    main_file = getattr(sys.modules.get("__main__"), "__file__", None)
    return os.path.abspath(main_file) if main_file else os.getcwd()


def _main_file() -> str:
    main_file = getattr(sys.modules.get("__main__"), "__file__", None)
    if main_file:
        return os.path.abspath(main_file)
    return os.path.abspath(__file__)


def _slug(name: Any) -> str:
    text = str(name or "").strip()
    # 中文/非 ASCII 名字保留原样：它只是显示名，不参与 DSH 的工具名规则。
    if text and not re.search(r"[A-Za-z0-9]", text):
        return text
    # 函数名 snake_case -> kebab-case（blackboard_open -> blackboard-open），
    # 这是插件与工具对外的约定，不能因为一次重写就丢掉。
    text = text.replace("_", "-").replace(" ", "-")
    text = re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-")
    text = text.lower()
    if not text:
        text = "tool"
    if not re.match(r"^[a-z]", text):
        text = "t-" + text
    return text


def _raise_for_syntax_landmines(filename: str) -> None:
    """在声明期就拦住「能 import 但行为诡异」的写法。

    典型是：注释行用制表符画装饰线（``# ─── 入口 ───``），那一行的 U+2500 系列字符
    属于 CJK 符号，Python 的行拼接规则会把下一行并进同一逻辑行，于是
    ``def main`` 的缩进错位，最后报出一个和真实原因毫无关系的
    ``TypeError: 'str' object is not callable``，还指向错误的行号。
    在这里提前说清楚，比让 agent 事后猜强得多。
    """
    try:
        with open(filename, "r", encoding="utf-8", errors="replace") as handle:
            lines = handle.readlines()
    except OSError:
        return
    for index, line in enumerate(lines):
        stripped = line.lstrip()
        if not stripped.startswith("#"):
            continue
        # 只查「注释里出现两个以上制表符区字符」
        if len(re.findall(r"[\u2500-\u257f]", stripped)) >= 2:
            WARNINGS.append(
                "%s:%d 注释里用了制表符装饰线（─ │ 等）。这类字符会让 Python 把下一行"
                "并进同一逻辑行，导致后面 def 的缩进错位、报出与真实原因无关的 "
                "'str' object is not callable。请换成普通字符，例如 '# --- 入口 ---'。"
                % (os.path.basename(filename), index + 1)
            )
            break


def _split_doc(doc: Optional[str]) -> "tuple[str, Dict[str, str]]":
    """把 docstring 拆成「首行摘要」和 Args 段里的参数说明。"""
    if not doc:
        return "", {}
    lines = doc.strip().splitlines()
    summary = ""
    for line in lines:
        text = line.strip()
        if text:
            summary = text
            break
    params: Dict[str, str] = {}
    in_args = False
    for line in lines:
        if re.match(r"^\s*(?:Args|Arguments|Parameters|参数)\s*:\s*$", line):
            in_args = True
            continue
        match = re.match(r"^\s*:param\s+(\w+)\s*:\s*(.*)$", line)
        if match:
            params[match.group(1)] = match.group(2).strip()
            continue
        if not in_args:
            continue
        if line.strip() == "" or not line.startswith((" ", "\t")):
            in_args = False
            continue
        match = re.match(r"^\s+([A-Za-z_]\w*)\s*(?:\([^)]*\))?\s*:\s*(.*)$", line)
        if match and match.group(1) not in params:
            params[match.group(1)] = match.group(2).strip()
    return summary, params


def _is_context_annotation(annotation: Any) -> bool:
    if annotation is ToolContext:
        return True
    return getattr(annotation, "__name__", "") == "ToolContext"


def _build_schema(fn: Callable[..., Any], name: str, overrides: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    hints = _resolved_hints(fn)
    try:
        signature = inspect.signature(fn)
    except (TypeError, ValueError):
        signature = None
    _, param_docs = _split_doc(getattr(fn, "__doc__", None))
    properties: Dict[str, Any] = {}
    required: "List[str]" = []
    if signature is not None:
        for parameter_name, parameter in signature.parameters.items():
            if parameter_name in ("ctx", "context") and parameter.default is inspect.Parameter.empty:
                continue
            annotation = hints.get(parameter_name, parameter.annotation)
            if _is_context_annotation(annotation):
                continue
            if parameter.kind in (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD):
                continue
            schema = _annotation_schema(annotation)
            if parameter_name in param_docs:
                schema = dict(schema)
                schema["description"] = param_docs[parameter_name]
            if parameter.default is not inspect.Parameter.empty and parameter.default is not None:
                schema = dict(schema)
                schema["default"] = _jsonable(parameter.default)
            properties[parameter_name] = schema
            if parameter.default is inspect.Parameter.empty:
                required.append(parameter_name)
    for key, value in (overrides or {}).items():
        merged = dict(properties.get(key, {}))
        merged.update(value or {})
        properties[key] = merged
    return {"type": "object", "properties": properties, "required": required}


def register(
    fn: Optional[Callable[..., Any]] = None,
    *,
    name: Optional[str] = None,
    description: str = "",
    parameters: Optional[Dict[str, Any]] = None,
    schema: Optional[Dict[str, Any]] = None,
    timeout: int = 120,
):
    """声明一个工具。可以直接当装饰器用：

        @register(description="把两数相加", timeout=30)
        def add(a: int, b: int) -> dict: ...

    Args:
        name: 覆盖工具名（默认取函数名的 kebab-case）。
        description: 给大脑看的说明；不给就取 docstring 首行。
        parameters: 单个参数的 schema 覆盖，例如 ``{"q": {"description": "..."}}``。
        schema: 整份 JSON Schema 覆盖。
        timeout: 单次调用超时（秒），上限 3600。
    """

    def decorate(target: Callable[..., Any]) -> Callable[..., Any]:
        tool_name = _slug(name or getattr(target, "__name__", "tool"))
        summary_text, _ = _split_doc(getattr(target, "__doc__", None))
        built = dict(schema) if schema else _build_schema(target, tool_name, parameters)
        TOOLS[tool_name] = {
            "name": tool_name,
            "description": description or summary_text or tool_name,
            "parameters": built,
            "timeoutMs": int(max(1, min(3600, timeout)) * 1000),
            "function": target,
        }
        _OWNER_FILES["tool:" + tool_name] = _caller_file(3)
        try:
            target.__pytools_tool__ = tool_name  # type: ignore[attr-defined]
        except (AttributeError, TypeError):
            pass
        return target

    if fn is not None and callable(fn):
        return decorate(fn)
    return decorate


def skill(
    name: Optional[str] = None,
    *,
    description: str = "",
    body: Any = None,
    when_to_use: Optional[str] = None,
    resources: Optional[Iterable[str]] = None,
    path: Optional[str] = None,
):
    """声明一个技能（markdown 正文）。

    两种写法，**不要混用**：

    .. code-block:: python

        # 写法一：装饰器（正文来自函数返回值）
        @skill("查表规范", description="何时查表、怎么查")
        def lookup_guide() -> str:
            return "# 查表规范\\n..."

        # 写法二：直接给正文（不是装饰器！）
        skill("查表规范", description="...", body="# 查表规范\\n...")

    ``body=`` / ``path=`` 时本函数**直接登记并返回 ``None``**；此时再在它前面加
    ``@`` 就会得到 ``TypeError: 'str' object is not callable`` —— 新版会当场
    指出这一点，而不是让 Python 报一个看不懂的类型错误。
    """
    if name is None:
        name = "skill"

    def decorate(target: Any) -> Any:
        resolved = _slug(name or getattr(target, "__name__", None) or "skill")
        body_ref: Optional[str] = None
        if isinstance(target, str):
            content: Optional[str] = target
        elif callable(target):
            body_ref = _callable_ref(target)
            content = None
        else:
            content = None
        description_text = description or ""
        if callable(target) and not description_text:
            summary, _ = _split_doc(getattr(target, "__doc__", None))
            description_text = summary
        resolved_path = path
        if resolved_path and not os.path.isabs(resolved_path):
            resolved_path = os.path.join(os.path.dirname(_main_file()), resolved_path)
        SKILLS[resolved] = {
            "name": resolved,
            "description": description_text or resolved,
            "whenToUse": when_to_use,
            "body": content,
            "bodyFrom": body_ref,
            "path": resolved_path,
            "resources": list(resources or []),
        }
        _OWNER_FILES["skill:" + resolved] = _caller_file(3)
        if callable(target):
            try:
                target.__pytools_skill__ = resolved  # type: ignore[attr-defined]
            except (AttributeError, TypeError):
                pass
        return target

    if body is not None or path is not None:
        content = body
        if isinstance(content, str) and content.lstrip().startswith("#"):
            # 判断是不是被误当成装饰器用了：body 已经给了，说明这是最终调用。
            decorate("" if content is None else content)
        else:
            decorate(content if isinstance(content, str) else "")
        WARNINGS.append(
            "skill(%r)：body=/path= 形式是「直接登记」，返回 None，不能再当前面的 @装饰器；"
            "如果需要装饰器写法，请去掉 body=/path= 并把正文放在函数里 return。" % name
        )
        return None
    return decorate


def describe(description: str = "", tags: Optional[Iterable[str]] = None) -> None:
    """给这个文件写一句总说明和几个标签（给大脑看的名片）。"""
    FILE_INFO["description"] = str(description or "")
    if tags is not None:
        FILE_INFO["tags"] = [str(item) for item in tags]


def _callable_ref(fn: Callable[..., Any]) -> str:
    module = getattr(fn, "__module__", None) or "__main__"
    qualname = getattr(fn, "__qualname__", getattr(fn, "__name__", "body"))
    return module + ":" + qualname


def _resolve_ref(reference: str) -> Any:
    module_name, _, qualname = reference.partition(":")
    module = sys.modules.get(module_name) or sys.modules.get("__main__")
    target: Any = module
    for part in (qualname or "").split("."):
        if not part or target is None:
            break
        try:
            target = getattr(target, part)
        except AttributeError:
            return None
    return target


# ══════════════════════════════════════════════════════════════════════════
# 五、执行一次调用
# ══════════════════════════════════════════════════════════════════════════


def _coerce(value: Any, annotation: Any) -> Any:
    """按类型注解做温和转换（模型给 "3" 而注解是 int 时转一下）。"""
    if annotation is inspect.Parameter.empty or value is None:
        return value
    if isinstance(annotation, str):
        base = _ANNOTATION_TOKENS.get(annotation.strip())
        annotation = base if base is not None else annotation
    try:
        if annotation is bool and isinstance(value, str):
            return value.strip().lower() in ("1", "true", "yes", "on")
        if annotation is int and isinstance(value, str):
            return int(value)
        if annotation is float and isinstance(value, (str, int)):
            return float(value)
        if annotation is str and not isinstance(value, str):
            return json.dumps(value, ensure_ascii=False) if isinstance(value, (dict, list)) else str(value)
    except (TypeError, ValueError):
        return value
    return value


def _call_with(fn: Callable[..., Any], arguments: Dict[str, Any], hints: Dict[str, Any]) -> Any:
    try:
        signature = inspect.signature(fn)
    except (TypeError, ValueError):
        return fn(**arguments)
    kwargs: Dict[str, Any] = {}
    accepts_extra = False
    for parameter_name, parameter in signature.parameters.items():
        if parameter.kind is inspect.Parameter.VAR_KEYWORD:
            accepts_extra = True
            continue
        if parameter.kind is inspect.Parameter.POSITIONAL_ONLY:
            continue
        if parameter_name in arguments:
            kwargs[parameter_name] = _coerce(arguments[parameter_name], hints.get(parameter_name, parameter.annotation))
    if accepts_extra:
        for key, value in arguments.items():
            kwargs.setdefault(key, value)
    return fn(**kwargs)


def _invoke(entry: Dict[str, Any], arguments: Dict[str, Any], ctx: ToolContext) -> Any:
    fn = entry.get("function")
    try:
        signature = inspect.signature(fn)
    except (TypeError, ValueError):
        signature = None
    hints = _resolved_hints(fn)
    if signature is not None:
        for parameter_name, parameter in signature.parameters.items():
            annotation = hints.get(parameter_name, parameter.annotation)
            wants = parameter_name in ("ctx", "context") or _is_context_annotation(annotation)
            if parameter_name in ("ctx", "context") and parameter.default is inspect.Parameter.empty:
                wants = True
            if wants and parameter_name not in arguments:
                merged = dict(arguments)
                merged[parameter_name] = ctx
                return _call_with(fn, merged, hints)
    return _call_with(fn, arguments, hints)


def _handle_call() -> int:
    """``python file.py __pytools_call__``：执行一次调用。"""
    call_file = os.environ.get(_ENV_CALL_FILE) or ""
    result_file = os.environ.get(_ENV_RESULT_FILE) or ""
    stream_file = os.environ.get(_ENV_STREAM_FILE) or None
    reply_file = os.environ.get(_ENV_REPLY_FILE) or None
    if not call_file or not os.path.exists(call_file):
        print("pytools: missing call frame (%s)" % _ENV_CALL_FILE, file=sys.stderr)
        return 2
    if not result_file:
        result_file = os.path.join(os.path.dirname(os.path.abspath(call_file)), "pytools_result.json")
    try:
        frame = _read_json_file(call_file)
    except Exception as error:
        print("pytools: unreadable call frame: %s" % error, file=sys.stderr)
        return 2
    protocol = str(frame.get("protocol") or PROTOCOL)
    if protocol not in _COMPAT_PROTOCOLS:
        print("pytools: 协议版本 %r 不认识（支持 %s）" % (protocol, ", ".join(_COMPAT_PROTOCOLS)), file=sys.stderr)
        return 2
    ctx = ToolContext(frame=frame, stream_path=stream_file, reply_path=reply_file)
    ToolContext._current = ctx
    started = time.time()
    payload: Dict[str, Any] = {
        "protocol": PROTOCOL,
        "callId": frame.get("callId"),
        "ok": False,
        "tool": frame.get("tool"),
        "startedAt": started,
    }
    try:
        tool_name = str(frame.get("tool") or "")
        entry = TOOLS.get(tool_name)
        if entry is None:
            raise KeyError("未注册的工具 %r（本文件声明了：%s）" % (tool_name, ", ".join(TOOLS) or "（无）"))
        value = _invoke(entry, dict(frame.get("arguments") or {}), ctx)
        payload["ok"] = True
        payload["value"] = _jsonable(value)
    except SystemExit as error:
        code = error.code if error.code is not None else 0
        payload["ok"] = code in (0, None)
        payload["value"] = None
        if not payload["ok"]:
            payload["error"] = {"type": "SystemExit", "message": "sys.exit(%r)" % (code,)}
    except BaseException as error:  # noqa: BLE001 —— 原样交给大脑，附完整 traceback
        payload["ok"] = False
        payload["error"] = {
            "type": type(error).__name__,
            "message": str(error),
            "traceback": traceback.format_exc(),
        }
    finally:
        payload["durationMs"] = int((time.time() - started) * 1000)
        payload["events"] = len(ctx.events)
        ctx.emit({"ok": bool(payload.get("ok"))}, kind="done")
        ctx.close()
        ToolContext._current = None
        try:
            _atomic_write_text(result_file, json.dumps(payload, ensure_ascii=False))
        except OSError as error:
            print("pytools: 写结果帧失败：%s" % error, file=sys.stderr)
            return 3
    return 0


# ══════════════════════════════════════════════════════════════════════════
# 六、常驻会话（手一直在听）
# ══════════════════════════════════════════════════════════════════════════


def serve(stdin=None, stdout=None) -> int:
    """常驻模式：从 stdin 一行一条读指令，向 stdout 一行一条回帧。

    指令（JSON 一行）：

        {"id": "1", "op": "call", "tool": "render", "arguments": {...}}
        {"id": "2", "op": "ping"}
        {"id": "3", "op": "manifest"}
        {"id": "4", "op": "shutdown"}

    回帧（JSON 一行）：

        {"id": "1", "kind": "result", "ok": true, "value": ...}
        {"id": "1", "kind": "event", "payload": ...}        （执行中随时推）
        {"id": "1", "kind": "ask", "askId": "...", "question": "..."}
        {"id": "1", "kind": "progress", "value": 0.5}

    答复 ``ask``：下一行写 ``{"op": "reply", "askId": "...", "answer": ...}``。

    这样多个调用可以交错进来（各自带 id），互不串号；同一个进程可以一直听。
    """
    stdin = stdin or sys.stdin
    stdout = stdout or sys.stdout
    emit_lock = __import__("threading").Lock()

    def send(frame: Dict[str, Any]) -> None:
        with emit_lock:
            stdout.write(json.dumps(_jsonable(frame), ensure_ascii=False) + "\n")
            stdout.flush()

    pending_replies: Dict[str, Any] = {}
    reply_lock = __import__("threading").Lock()

    class ServeContext(ToolContext):
        """常驻会话里的上下文：帧走 stdout，而不是文件。"""

    def run_one(request: Dict[str, Any]) -> None:
        request_id = request.get("id")
        tool_name = str(request.get("tool") or "")
        entry = TOOLS.get(tool_name)
        if entry is None:
            send({"id": request_id, "kind": "result", "ok": False,
                  "error": {"type": "KeyError", "message": "未注册的工具 %r" % tool_name}})
            return
        ctx = ServeContext(frame={"callId": request_id, "tool": tool_name,
                                  "arguments": request.get("arguments") or {},
                                  "requestId": request_id})
        ctx._seq_emit = lambda payload, kind="data", _c=ctx: send(  # type: ignore[attr-defined]
            {"id": request_id, "kind": kind, "payload": _jsonable(payload)})
        ToolContext._current = ctx
        started = time.time()
        try:
            value = _invoke(entry, dict(request.get("arguments") or {}), ctx)
            send({"id": request_id, "kind": "result", "ok": True, "value": _jsonable(value),
                  "durationMs": int((time.time() - started) * 1000)})
        except BaseException as error:  # noqa: BLE001
            send({"id": request_id, "kind": "result", "ok": False,
                  "error": {"type": type(error).__name__, "message": str(error),
                            "traceback": traceback.format_exc()}})
        finally:
            ToolContext._current = None

    # 覆盖 ServeContext.emit 走 stdout（而不是文件）
    _orig_emit = ToolContext.emit

    def emit_to_stdout(self, payload, /, *, kind="data"):
        sender = getattr(self, "_seq_emit", None)
        if callable(sender) and isinstance(self, ServeContext):
            sender(payload, kind)
            return
        _orig_emit(self, payload, kind=kind)

    ToolContext.emit = emit_to_stdout  # type: ignore[assignment]
    try:
        send({"kind": "ready", "pid": os.getpid(), "protocol": PROTOCOL,
              "version": VERSION, "tools": sorted(TOOLS)})
        worker_threads: List[Any] = []
        for line in stdin:
            line = line.strip()
            if not line:
                continue
            try:
                request = json.loads(line)
            except ValueError:
                send({"kind": "error", "error": {"type": "ValueError", "message": "不是合法 JSON"}})
                continue
            op = str(request.get("op") or "call")
            if op == "ping":
                send({"id": request.get("id"), "kind": "pong", "t": time.time()})
            elif op == "manifest":
                send({"id": request.get("id"), "kind": "manifest", "value": _manifest()})
            elif op == "reply":
                with reply_lock:
                    pending_replies[str(request.get("askId"))] = request.get("answer")
            elif op == "shutdown":
                send({"kind": "bye"})
                break
            elif op == "call":
                thread = __import__("threading").Thread(target=run_one, args=(request,), daemon=True)
                thread.start()
                worker_threads.append(thread)
            else:
                send({"id": request.get("id"), "kind": "error",
                      "error": {"type": "ValueError", "message": "不认识的 op %r" % op}})
        for thread in worker_threads:
            thread.join(timeout=5.0)
    finally:
        ToolContext.emit = _orig_emit  # type: ignore[assignment]
    return 0


