# 三、工具上下文（Python 侧对大脑的「神经末梢」）
# ══════════════════════════════════════════════════════════════════════════


def _jsonable(value: Any) -> Any:
    """把任意返回值化成可 JSON 的形式（dataclass / namedtuple / bytes / set ...）。"""
    if value is None or isinstance(value, (bool, int, float, str)):
        return value
    if isinstance(value, bytes):
        try:
            return value.decode("utf-8")
        except UnicodeDecodeError:
            import base64

            return base64.b64encode(value).decode("ascii")
    if isinstance(value, dict):
        return {str(k): _jsonable(v) for k, v in value.items()}
    if isinstance(value, (list, tuple, set, frozenset)):
        return [_jsonable(item) for item in value]
    for method in ("to_dict", "_asdict", "model_dump", "dict"):
        if callable(getattr(value, method, None)):
            try:
                return _jsonable(getattr(value, method)())
            except Exception:
                continue
    if hasattr(value, "__dict__") and not isinstance(value, type):
        try:
            return {str(k): _jsonable(v) for k, v in vars(value).items() if not k.startswith("_")}
        except TypeError:
            pass
    return repr(value)


class DshBridge:
    """Python 这一侧的 DSH 出口。

    只做传输，不解释内容：

    * :meth:`emit` —— 推一帧数据回大脑（普通反馈）；
    * :meth:`notify` —— 弹一条给人看的通知；
    * :meth:`log` —— 记一条日志；
    * :meth:`act` —— 申请一个动作（带 actionId）。

    没有 ``ask`` / ``call``：历史上这两个方法存在但宿主从未实现，调用必然抛错，
    已经移除。需要「问了再继续」的逻辑，请用动作 + 反馈自己组合。
    """

    def __init__(self, ctx: "ToolContext") -> None:
        self._ctx = ctx

    def emit(self, event: Any, *, kind: str = "data", dataType: str = "") -> None:
        self._ctx.emit(event, kind=kind, dataType=dataType)

    def event(self, event: Any) -> None:
        """Python 主动推一条事件（普通反馈，不阻塞）。"""
        self._ctx.emit(event, kind="event")

    def notify(self, text: str) -> None:
        self._ctx.emit(str(text), kind="notify")

    def log(self, level: str, message: str) -> None:
        self._ctx.emit({"level": level, "message": str(message)}, kind="log")

    def act(self, name: str, arguments: Optional[Dict[str, Any]] = None, *,
            action_id: str = "", note: str = "") -> Dict[str, Any]:
        """:meth:`ToolContext.act` 的桥接版本。"""
        return self._ctx.act(name, arguments or {}, action_id=action_id, note=note)

    @property
    def call_id(self) -> str:
        return self._ctx.frame.get("callId", "")

    @property
    def tool_name(self) -> str:
        return self._ctx.frame.get("tool", "")

    @property
    def dsh_name(self) -> str:
        return self._ctx.frame.get("dshName", "") or self._ctx.frame.get("tool", "")

    @property
    def file(self) -> str:
        return self._ctx.frame.get("file", "")

    @property
    def call_arguments(self) -> Dict[str, Any]:
        return dict(self._ctx.frame.get("arguments") or {})

    @property
    def registered(self) -> bool:
        return bool(self._ctx.frame)


class ToolContext:
    """传给工具函数的上下文（``ctx``）。

    工具函数声明一个注解为 :class:`ToolContext`（或直接命名为 ``ctx`` / ``context``）
    的参数，就会拿到它；它不会出现在给大脑看的参数表里。
    """

    _current: "Optional[ToolContext]" = None

    @classmethod
    def current_context(cls) -> "Optional[ToolContext]":
        return cls._current

    @classmethod
    def require(cls) -> "ToolContext":
        ctx = cls._current
        if ctx is None:
            raise RuntimeError("没有当前工具上下文：这段代码不在一次 pytools 调用里运行")
        return ctx

    def __init__(
        self,
        frame: Optional[Dict[str, Any]] = None,
        stream_path: Optional[str] = None,
        reply_path: Optional[str] = None,
    ) -> None:
        self.frame: Dict[str, Any] = frame or {}
        self.stream_path = stream_path
        self.reply_path = reply_path
        self._seq = 0
        self._stream = None
        self._ask_seq = 0
        self.events: List[Dict[str, Any]] = []
        self.dsh = DshBridge(self)

    # ── 流 ──
    def _open_stream(self):
        if self._stream is not None:
            return self._stream
        if not self.stream_path:
            return None
        try:
            self._stream = open(self.stream_path, "a", encoding="utf-8", buffering=1)
        except OSError:
            self._stream = None
        return self._stream

    def emit(self, payload: Any, /, *, kind: str = "data", dataType: str = "") -> None:
        """写一帧到流出。任何时候都能调用，包括异常处理里。

        ``dataType`` 只对 ``kind="data"`` 有意义：它说明「这段数据是什么」，
        例如 ``"table.stats"``、``"screenshot.bbox"``。插件原样转交，不做解释。
        不传就和以前完全一样。
        """
        self._seq += 1
        frame = {
            "seq": self._seq,
            "t": time.time(),
            "kind": kind,
            "payload": _jsonable(payload),
        }
        if dataType:
            frame["dataType"] = str(dataType)
        self.events.append(frame)
        handle = self._open_stream()
        if handle is None:
            return
        try:
            handle.write(_FRAME_BEGIN + " " + json.dumps(frame, ensure_ascii=False) + "\n")
            handle.flush()
        except (OSError, ValueError):
            pass

    def log(self, message: str, level: str = "info") -> None:
        self.emit({"level": level, "message": str(message)}, kind="log")

    def progress(self, value: float, message: str = "") -> None:
        """上报进度，``value`` 取 0..1（也接受 0..100，自动归一）。"""
        try:
            number = float(value)
        except (TypeError, ValueError):
            number = 0.0
        if number > 1.0:
            number = number / 100.0
        self.emit({"value": max(0.0, min(1.0, number)), "message": str(message)}, kind="progress")

    def event(self, payload: Any) -> None:
        """推一条普通事件（与 data 的区别只是语义：这是「喂给大脑的反馈」）。"""
        self.emit(payload, kind="event")

    def act(self, name: str, arguments: Optional[Dict[str, Any]] = None, *,
            action_id: str = "", note: str = "") -> Dict[str, Any]:
        """申请一个动作：请求 DSH 去做一件事。只写申请，不等结果。

        这是「动作」而不是「数据」：它带一个 ``actionId``，DSH 收到后可以回
        ``ack`` / ``result``，也可以直接不管。插件只负责送到，不保证被处理。

        Args:
            name: 动作名，例如 ``"open_panel"``。DSH 侧按名字自己决定做什么。
            arguments: 动作参数（任意 JSON）。
            action_id: 自定义 id；不传就自动生成。
            note: 给人看的说明。

        Returns:
            写进去的申请记录（含 ``actionId``）。
        """
        act_id = str(action_id or "") or "act_%s" % uuid.uuid4().hex[:12]
        record = _emit_request("action", {
            "actionId": act_id,
            "name": str(name or ""),
            "arguments": _jsonable(dict(arguments or {})),
            "note": str(note or ""),
        })
        record["actionId"] = act_id
        return record

    def ack(self, action_id: str, value: Any = None) -> None:
        """回报「收到了某个动作」。"""
        self.emit({"actionId": str(action_id), "value": _jsonable(value)}, kind="ack")

    def action_result(self, action_id: str, ok: bool = True, value: Any = None,
                      error: Any = None) -> None:
        """回报「某个动作做完了」。失败就把 error 带上。"""
        payload: Dict[str, Any] = {"actionId": str(action_id), "ok": bool(ok)}
        if value is not None:
            payload["value"] = _jsonable(value)
        if error is not None:
            payload["error"] = _jsonable(error)
        self.emit(payload, kind="result")

    def action_progress(self, action_id: str, value: float, message: str = "") -> None:
        """回报某个动作的进度（0..1）。"""
        number = max(0.0, min(1.0, float(value)))
        self.emit({"actionId": str(action_id), "value": number, "message": str(message)},
                  kind="progress")

    # 便利属性
    @property
    def call_id(self) -> str:
        return self.frame.get("callId", "")

    @property
    def session_id(self) -> str:
        return self.frame.get("sessionId", "")

    @property
    def tool_name(self) -> str:
        return self.frame.get("tool", "")

    @property
    def dsh_name(self) -> str:
        return self.frame.get("dshName", "") or self.frame.get("tool", "")

    @property
    def file(self) -> str:
        return self.frame.get("file", "")

    @property
    def call_arguments(self) -> Dict[str, Any]:
        return dict(self.frame.get("arguments") or {})

    @property
    def registered(self) -> bool:
        return bool(self.frame)

    def close(self) -> None:
        if self._stream is not None:
            try:
                self._stream.flush()
                self._stream.close()
            except OSError:
                pass
            self._stream = None


def current_context() -> Optional[ToolContext]:
    return ToolContext._current


def emit(event: Any, *, kind: str = "data", dataType: str = "") -> None:
    """推一帧数据回大脑。``dataType`` 说明这段数据是什么（可省略）。"""
    ctx = ToolContext._current
    if ctx is None:
        raise RuntimeError("emit() 必须在一次工具调用里使用（没有当前上下文）")
    ctx.emit(event, kind=kind, dataType=dataType)


def act(name: str, arguments: Optional[Dict[str, Any]] = None, *,
        action_id: str = "", note: str = "") -> Dict[str, Any]:
    """申请一个动作（不需要 ctx 的快捷方式）。只写申请，不等结果。"""
    act_id = str(action_id or "") or "act_%s" % uuid.uuid4().hex[:12]
    record = _emit_request("action", {
        "actionId": act_id,
        "name": str(name or ""),
        "arguments": _jsonable(dict(arguments or {})),
        "note": str(note or ""),
    })
    record["actionId"] = act_id
    return record


def ack(action_id: str, value: Any = None) -> None:
    """回报「收到了某个动作」。"""
    ctx = ToolContext._current
    if ctx is None:
        raise RuntimeError("ack() 必须在一次工具调用里使用（没有当前上下文）")
    ctx.ack(action_id, value)


def action_result(action_id: str, ok: bool = True, value: Any = None, error: Any = None) -> None:
    """回报「某个动作做完了」。"""
    ctx = ToolContext._current
    if ctx is None:
        raise RuntimeError("action_result() 必须在一次工具调用里使用（没有当前上下文）")
    ctx.action_result(action_id, ok=ok, value=value, error=error)


def log(message: str, level: str = "info") -> None:
    ctx = ToolContext._current
    if ctx is not None:
        ctx.log(message, level)
    else:
        print("[pytools/%s] %s" % (level, message), file=sys.stderr)




