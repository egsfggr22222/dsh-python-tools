def pid_alive(pid: Any) -> bool:
    """进程还活着吗。

    不调 tasklist（每次几毫秒到几十毫秒），直接用 OpenProcess，快一个数量级。
    """
    try:
        value = int(pid)
    except (TypeError, ValueError):
        return False
    if value <= 0:
        return False
    if _is_windows():
        import ctypes
        # PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        handle = ctypes.windll.kernel32.OpenProcess(0x1000, False, value)
        if not handle:
            return False
        try:
            # 已退出的进程也可能拿得到句柄（僵尸），再看一眼退出码
            code = ctypes.c_ulong(0)
            ok = ctypes.windll.kernel32.GetExitCodeProcess(handle, ctypes.byref(code))
            if ok and code.value != 259:      # 259 = STILL_ACTIVE
                return False
            return True
        finally:
            ctypes.windll.kernel32.CloseHandle(handle)
    try:
        os.kill(value, 0)
        return True
    except OSError:
        return False


def spawn_background(argv: "List[str]", *, cwd: str = "", log: str = "") -> int:
    """起一个脱离的常驻进程（本进程退出后它继续活）。返回 pid。

    Args:
        argv: 命令行，第一项是程序。
        cwd: 工作目录；空就用当前目录。
        log: 把 stdout/stderr 追写到这个文件；空就丢掉。
    """
    import subprocess

    flags = _detached_flags()
    kwargs: Dict[str, Any] = {
        "stdin": subprocess.DEVNULL,
        "cwd": cwd or None,
        **flags,
    }
    handle = None
    if log:
        os.makedirs(os.path.dirname(os.path.abspath(log)), exist_ok=True)
        handle = open(log, "a", encoding="utf-8")
        kwargs["stdout"] = handle
        kwargs["stderr"] = handle
    else:
        kwargs["stdout"] = subprocess.DEVNULL
        kwargs["stderr"] = subprocess.DEVNULL
    try:
        child = subprocess.Popen(list(argv), **kwargs)
        return int(child.pid)
    finally:
        if handle is not None:
            handle.close()


def kill_process(pid: Any, *, timeout: float = 3.0) -> bool:
    """精确杀掉一个进程（先温柔后强硬）。返回是否确认它已经没了。"""
    try:
        value = int(pid)
    except (TypeError, ValueError):
        return False
    if value <= 0 or not pid_alive(value):
        return True
    import signal as _signal
    try:
        os.kill(value, _signal.SIGTERM)
    except Exception:
        pass
    deadline = time.time() + max(0.2, timeout)
    while time.time() < deadline:
        if not pid_alive(value):
            return True
        time.sleep(0.05)
    try:
        os.kill(value, 9)
    except Exception:
        pass
    return not pid_alive(value)


