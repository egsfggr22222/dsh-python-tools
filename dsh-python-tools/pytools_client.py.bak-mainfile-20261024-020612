# 二、注解兼容层（3.8 ~ 3.13 一视同仁）
# ══════════════════════════════════════════════════════════════════════════

_ANNOTATION_TYPES = {
    "int": ("integer", int),
    "float": ("number", float),
    "str": ("string", str),
    "bool": ("boolean", bool),
    "list": ("array", list),
    "dict": ("object", dict),
    "tuple": ("array", tuple),
    "set": ("array", set),
    "None": ("null", type(None)),
}

# 允许注解里出现的名字：只做「查表」，绝不 eval 任意表达式。
_ANNOTATION_TOKENS = {name: value for name, (_, value) in _ANNOTATION_TYPES.items()}
_ANNOTATION_TOKENS.update({"List": list, "Dict": dict, "Tuple": tuple, "Set": set, "Any": object})


def _union_args(annotation: Any) -> Optional[List[Any]]:
    """取出 ``Optional[X]`` / ``Union[X, Y]`` / ``X | Y`` 里的成员；不是联合类型就返回 None。"""
    origin = typing.get_origin(annotation)
    if origin is typing.Union:
        return list(typing.get_args(annotation) or [])
    # Python 3.10+ 的 X | Y 会产生 types.UnionType，get_origin 可能返回 types.UnionType
    union_type = getattr(__import__("types"), "UnionType", None)
    if union_type is not None and (origin is union_type or isinstance(annotation, union_type)):
        return list(typing.get_args(annotation) or [])
    return None


def _annotation_schema(annotation: Any) -> Dict[str, Any]:
    """把类型注解翻译成 JSON Schema 的一小片。"""
    if annotation is inspect.Parameter.empty or annotation is Any:
        return {}
    if annotation is type(None):
        return {"type": "null"}
    if isinstance(annotation, str):
        # from __future__ import annotations 下注解是字符串：只做安全查表
        text = annotation.strip()
        parts = _union_args(_parse_light_union(text))
        if parts is not None:
            resolved = [x for x in parts if x is not type(None)]
            schema = _annotation_schema(resolved[0]) if len(resolved) == 1 else {}
            if len(parts) != len(resolved):
                schema = dict(schema)
                schema["nullable"] = True
            return schema
        base = _ANNOTATION_TOKENS.get(text)
        if base is None:
            # list[str] / dict[str, int] 之类：取外层
            head = re.split(r"[\[\(]", text, maxsplit=1)[0].strip()
            base = _ANNOTATION_TOKENS.get(head)
        if base is None:
            return {}
        for name, (kind, cls) in _ANNOTATION_TYPES.items():
            if cls is base:
                return {"type": kind}
        return {}
    parts = _union_args(annotation)
    if parts is not None:
        resolved = [item for item in parts if item is not type(None)]
        schema = _annotation_schema(resolved[0]) if len(resolved) == 1 else {}
        if len(parts) != len(resolved):
            schema = dict(schema)
            schema["nullable"] = True
        return schema
    try:
        for name, (kind, cls) in _ANNOTATION_TYPES.items():
            if annotation is cls:
                return {"type": kind}
        if isinstance(annotation, type) and issubclass(annotation, (list, tuple, set)):
            return {"type": "array"}
        if isinstance(annotation, type) and issubclass(annotation, dict):
            return {"type": "object"}
        if isinstance(annotation, type) and getattr(annotation, "__members__", None):
            return {"type": "string", "enum": list(annotation.__members__)}
    except TypeError:
        return {}
    return {}


def _parse_light_union(text: str) -> Any:
    """把 ``Optional[int]`` / ``int | None`` 这类字符串安全地拆成成员列表。

    只识别本模块白名单里的名字，其余返回 ``inspect.Parameter.empty``；不执行任何代码。
    """
    inner = text
    match = re.match(r"^Optional\[(.*)\]$", text)
    if match:
        return typing.Optional[_ANNOTATION_TOKENS.get(match.group(1).strip(), object)]
    match = re.match(r"^Union\[(.*)\]$", text)
    if match:
        return typing.Union[
            tuple(_ANNOTATION_TOKENS.get(part.strip(), object) for part in match.group(1).split(","))
        ]
    if "|" in text:
        members = []
        for part in text.split("|"):
            part = part.strip()
            if part == "None":
                members.append(type(None))
            else:
                members.append(_ANNOTATION_TOKENS.get(part, object))
        inner = None
        return typing.Union[tuple(members)]
    return inspect.Parameter.empty


def _resolved_hints(fn: Callable[..., Any]) -> Dict[str, Any]:
    """拿到函数注解；失败就退回原始注解，绝不因为一个奇怪注解炸掉整个声明。"""
    try:
        return typing.get_type_hints(fn)
    except Exception:
        return dict(getattr(fn, "__annotations__", {}) or {})


