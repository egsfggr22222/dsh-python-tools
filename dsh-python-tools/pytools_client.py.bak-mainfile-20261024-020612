# 生命周期声明：调了 follow_lifecycle() 就置 True。
# 置 True 后，agent 每轮结束（DSH 的 agent/status = idle）时，
# 插件会以 --lifecycle agent-idle 再跑一次这个文件，让它自己收尾。
LIFECYCLE: Dict[str, Any] = {"follow": False}


def follow_lifecycle(enabled: bool = True) -> None:
    """声明「agent 停下时请通知我」。

    为什么需要：长驻进程（字幕、黑板）自己感知不到「用户把 agent 停了」，
    而 agent 被中止后也没机会去通知它们。插件跟着 DSH 活着，能收到 agent 状态，
    所以由它转一手。

    声明之后，agent 每轮结束时插件会跑：

        python 你的文件.py --lifecycle agent-idle

    你只要在 main() 之前或 __main__ 里处理这个参数即可（见下面示例）。

    示例：

        from pytools_client import follow_lifecycle
        follow_lifecycle()

        if __name__ == "__main__":
            event = pytools.lifecycle_event()
            if event == "agent-idle":
                do_cleanup()          # 自己收尾：停语音、清字幕……
            else:
                raise SystemExit(main())
    """
    LIFECYCLE["follow"] = bool(enabled)


def lifecycle_event(argv: Optional[List[str]] = None) -> str:
    """取 --lifecycle 参数的值；不是生命周期调用就返回空字符串。"""
    args = list(sys.argv[1:] if argv is None else argv)
    for index, item in enumerate(args):
        if item == "--lifecycle" and index + 1 < len(args):
            return str(args[index + 1])
        if item.startswith("--lifecycle="):
            return item.split("=", 1)[1]
    return ""


