def poll_actions(reset: bool = False) -> "List[Dict[str, Any]]":
    """取走 DSH 投给本文件、还没被读过的新动作。取走即推进游标，不会重复给。

    这是「收话」的那一端。动作里有什么、要不要理，全由你自己决定；
    不做任何事也不会报错 —— 插件只是把话送到。

    Args:
        reset: True = 从头开始读（忽略游标）。

    Returns:
        动作记录列表，每条含 ``actionId`` / ``name`` / ``arguments``。
    """
    mailbox = action_mailbox()
    offset_file = os.path.join(state_dir(), "actions.offset")
    offset = 0 if reset else int(read_json(offset_file, {}) .get("offset", 0) or 0)
    if not os.path.isfile(mailbox):
        return []
    out: List[Dict[str, Any]] = []
    try:
        size = os.path.getsize(mailbox)
        if size <= offset:
            return []
        with open(mailbox, "r", encoding="utf-8") as handle:
            handle.seek(offset)
            chunk = handle.read()
            new_offset = handle.tell()
    except OSError:
        return []
    last_break = chunk.rfind("\n")
    if last_break < 0:
        return []
    complete = chunk[: last_break + 1]
    for line in complete.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if isinstance(item, dict):
            out.append(item)
    write_json(offset_file, {"offset": offset + len(complete.encode("utf-8"))})
    return out


def read_json(path: str, default: Any = None) -> Any:
    """读 JSON；文件不存在或坏了就返回 default。"""
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default if default is not None else {}


def write_json(path: str, payload: Any) -> None:
    """原子写 JSON（先写临时文件再换名，避免读到半个文件）。

    payload 可以直接给对象，也可以给已经序列化好的 JSON 字符串
    （很多旧代码习惯先 json.dumps 再写）。
    """
    directory = os.path.dirname(os.path.abspath(path))
    os.makedirs(directory, exist_ok=True)
    if isinstance(payload, str):
        text = payload
    else:
        text = json.dumps(payload, ensure_ascii=False)
    tmp = "%s.%d.%d.tmp" % (path, os.getpid(), threading.get_ident())
    with open(tmp, "w", encoding="utf-8", newline="\n") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)


def read_lines(path: str) -> "List[Dict[str, Any]]":
    """读一个 JSONL 文件，返回能解析的那些行。"""
    if not os.path.isfile(path):
        return []
    out: List[Dict[str, Any]] = []
    try:
        with open(path, "r", encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    item = json.loads(line)
                except ValueError:
                    continue
                if isinstance(item, dict):
                    out.append(item)
    except OSError:
        return []
    return out


def append_line(path: str, payload: Dict[str, Any]) -> None:
    """往 JSONL 文件追加一行。"""
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(payload, ensure_ascii=False) + "\n")


