# 七、清单、技能正文、自检
# ══════════════════════════════════════════════════════════════════════════


def _skill_body(entry: Dict[str, Any]) -> str:
    if entry.get("body") is not None:
        return str(entry["body"])
    ref = entry.get("bodyFrom")
    if ref:
        fn = _resolve_ref(str(ref))
        if callable(fn):
            try:
                return str(fn())
            except Exception as error:  # noqa: BLE001
                return "# 技能正文读取失败\n\n%s: %s" % (type(error).__name__, error)
    path = entry.get("path")
    if path and os.path.isfile(str(path)):
        try:
            with open(str(path), "r", encoding="utf-8") as handle:
                return handle.read()
        except OSError as error:
            return "# 技能文件读取失败：%s" % error
    return ""


def _manifest() -> Dict[str, Any]:
    tools = []
    for name, entry in TOOLS.items():
        tools.append({
            "name": name,
            "description": entry.get("description") or name,
            "parameters": entry.get("parameters") or {"type": "object", "properties": {}},
            "timeoutMs": entry.get("timeoutMs", 120000),
            "output": None,
        })
    skills = []
    for name, entry in SKILLS.items():
        skills.append({
            "name": name,
            "description": entry.get("description") or name,
            "whenToUse": entry.get("whenToUse"),
        })
    return {
        "protocol": PROTOCOL,
        "python": platform.python_version(),
        "executable": sys.executable,
        "file": _main_file(),
        "info": dict(FILE_INFO),
        "tools": tools,
        "skills": skills,
        "warnings": list(WARNINGS),
        "followLifecycle": bool(LIFECYCLE["follow"]),
    }


def doctor(root: Optional[str] = None) -> Dict[str, Any]:
    """自检：把「为什么这个环境能跑 / 为什么跑不起来」一次说清。"""
    import importlib.util

    here = os.path.dirname(os.path.abspath(__file__))
    path_entries = [str(item) for item in sys.path if item]
    findings: Dict[str, Any] = {
        "protocol": PROTOCOL,
        "clientVersion": VERSION,
        "python": platform.python_version(),
        "pythonOk": sys.version_info >= (3, 8),
        "executable": sys.executable,
        "platform": platform.platform(),
        "clientDir": here,
        "clientDirOnPath": here in path_entries,
        "cwd": os.getcwd(),
        "env": {
            "PYTHONPATH": os.environ.get("PYTHONPATH", ""),
            "PYTOOLS_CLIENT_DIR": os.environ.get("PYTOOLS_CLIENT_DIR", ""),
            "PYTOOLS_HOST": os.environ.get("PYTOOLS_HOST", ""),
            "PYTOOLS_HOST_VERSION": os.environ.get("PYTOOLS_HOST_VERSION", ""),
        },
        "importable": importlib.util.find_spec("pytools_client") is not None,
        "tools": sorted(TOOLS),
        "skills": sorted(SKILLS),
        "warnings": list(WARNINGS),
    }
    if root and os.path.isdir(root):
        findings["files"] = sorted(
            os.path.join(root, name) for name in os.listdir(root) if name.endswith(".py")
        )
    problems: List[str] = []
    if not findings["pythonOk"]:
        problems.append("Python 版本低于 3.8：请换一个 3.8+ 的解释器（当前 %s）。" % platform.python_version())
    if not findings["importable"]:
        problems.append("当前解释器 import 不到 pytools_client：检查 PYTHONPATH 或把本文件目录加进 sys.path。")
    if WARNINGS:
        problems.append("声明期发现 %d 条写法问题，见 warnings。" % len(WARNINGS))
    findings["problems"] = problems
    findings["ok"] = not problems
    return findings


