# 申请目录：~/.dsh/python-tools/requests/
# 一个文件一个通道：<label>.jsonl
REQUESTS: Dict[str, Any] = {"enabled": False}


def _requests_dir() -> str:
    root = os.environ.get("PYTOOLS_REQUESTS_DIR")
    if root:
        return root
    home = os.environ.get("DSH_HOME") or os.path.join(os.path.expanduser("~"), ".dsh")
    return os.path.join(home, "python-tools", "requests")


def _request_file() -> str:
    """本文件对应的申请文件。文件名用主文件名，避免两个工具抢同一个。"""
    main = _main_file() or "unknown"
    stem = os.path.splitext(os.path.basename(main))[0] or "unknown"
    safe = "".join(ch if (ch.isalnum() or ch in "-_.") else "_" for ch in stem)
    return os.path.join(_requests_dir(), safe + ".jsonl")


def _emit_request(kind: str, payload: Dict[str, Any]) -> Dict[str, Any]:
    """写一条申请。只写文件，不保证对方已处理 —— 这是“申请”的本义。"""
    item = {
        "kind": kind,
        "file": _main_file(),
        "at": time.time(),
        **payload,
    }
    path = _request_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(item, ensure_ascii=False) + "\n")
    return item


def interrupt(reason: str = "") -> Dict[str, Any]:
    """申请终止 agent 当前这一轮对话。

    只写申请，不直接动手 —— 插件读到后交给 DSH，由 DSH 决定如何中断。

    Args:
        reason: 为什么请求中断，会原样带给 agent。

    Returns:
        写进去的申请记录。
    """
    return _emit_request("interrupt", {"reason": str(reason or "")})


def send_message(text: str, interrupt: bool = False) -> Dict[str, Any]:
    """申请给 agent 发一条消息。

    Args:
        text: 要交给 agent 的内容。
        interrupt: True = 先申请中断当前对话，再看这条消息。

    Returns:
        写进去的申请记录。
    """
    body = str(text or "")
    if not body.strip():
        raise ValueError("send_message 的 text 不能为空")
    return _emit_request("message", {"text": body, "interrupt": bool(interrupt)})


def notify(text: str) -> Dict[str, Any]:
    """申请弹一条面向人的通知（不进入对话）。"""
    body = str(text or "")
    if not body.strip():
        raise ValueError("notify 的 text 不能为空")
    return _emit_request("notify", {"text": body})


