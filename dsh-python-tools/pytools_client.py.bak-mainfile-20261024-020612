def _is_windows() -> bool:
    return os.name == "nt"


def _pid_alive(pid: Any) -> bool:
    """进程是否还活着。三个平台各用各的办法，互不依赖外部命令的格式。"""
    if not isinstance(pid, int) or pid <= 0:
        return False
    if pid == os.getpid():
        return True
    if _is_windows():
        try:
            out = subprocess.run(
                ["tasklist", "/FI", "PID eq %d" % pid, "/NH"],
                capture_output=True,
                timeout=5,
                creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            )
            return str(pid).encode() in (out.stdout or b"")
        except Exception:
            return False
    try:
        os.kill(pid, 0)  # Linux / macOS：信号 0 只探测不发送
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # 存在但不属于我们
    except OSError:
        return False


def _detached_flags() -> Dict[str, Any]:
    """让子进程脱离当前终端/会话，宿主退出也不连带杀掉。"""
    if _is_windows():
        return {
            "creationflags": getattr(subprocess, "DETACHED_PROCESS", 0)
            | getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
        }
    return {"start_new_session": True}


def _hidden_flags() -> Dict[str, Any]:
    """只需要「不弹黑窗」，不需要脱离会话。"""
    if _is_windows():
        return {"creationflags": getattr(subprocess, "CREATE_NO_WINDOW", 0)}
    return {}


def _python_exe() -> str:
    return sys.executable or ("python" if _is_windows() else "python3")


def _atomic_write_text(path: str, text: str) -> None:
    """先写临时文件再改名：读的一方不会看到半个文件。"""
    folder = os.path.dirname(os.path.abspath(path))
    if folder:
        os.makedirs(folder, exist_ok=True)
    tmp = path + ".%d.%s.tmp" % (os.getpid(), uuid.uuid4().hex[:8])
    with open(tmp, "w", encoding="utf-8", newline="\n") as handle:
        handle.write(text)
    os.replace(tmp, path)


def _read_json_file(path: str) -> Dict[str, Any]:
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


