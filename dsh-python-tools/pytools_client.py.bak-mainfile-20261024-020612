# 八、命令行入口
# ══════════════════════════════════════════════════════════════════════════


def main(argv: Optional[List[str]] = None) -> int:
    """argparse 之前的手工解析：DSH 插件只认这几种参数。"""
    args = list(sys.argv[1:] if argv is None else argv)
    # 每次声明先体检一遍「能 import 但行为诡异」的写法（如 CJK 装饰线吞行）
    _raise_for_syntax_landmines(_main_file())
    if args[:1] == ["--manifest"]:
        print(json.dumps(_manifest(), ensure_ascii=False))
        return 0
    if args[:1] == ["--list"]:
        for name, entry in TOOLS.items():
            print("tool\t%s\t%s" % (name, entry.get("description") or name))
        for name, entry in SKILLS.items():
            print("skill\t%s\t%s" % (name, entry.get("description") or name))
        return 0
    if args[:1] == ["--skill"]:
        name = args[1] if len(args) > 1 else ""
        entry = SKILLS.get(name)
        if entry is None:
            print("pytools: 没有技能 %r（有：%s）" % (name, ", ".join(SKILLS) or "（无）"), file=sys.stderr)
            return 1
        print(_skill_body(entry))
        return 0
    if args[:1] == ["--doctor"]:
        print(json.dumps(doctor(_main_file_dir()), ensure_ascii=False, indent=2))
        return 0
    if args[:1] == [_CLI_SUBCOMMAND]:
        return _handle_call()
    if args[:1] == [_SERVE_SUBCOMMAND]:
        return serve()
    # 默认：名片
    print("Python Tools file: %s" % _main_file())
    print("python %s  (%s)" % (platform.python_version(), sys.executable))
    if FILE_INFO.get("description"):
        print(FILE_INFO["description"])
    print("tools (%d):" % len(TOOLS))
    for name, entry in TOOLS.items():
        print("  - %s: %s" % (name, entry.get("description") or name))
    print("skills (%d):" % len(SKILLS))
    for name, entry in SKILLS.items():
        print("  - %s: %s" % (name, entry.get("description") or name))
    for warning in WARNINGS:
        print("WARN: %s" % warning, file=sys.stderr)
    return 0


def _main_file_dir() -> str:
    try:
        return os.path.dirname(_main_file())
    except Exception:
        return os.getcwd()


def _cli() -> int:
    """``pip install`` 后的命令行入口（pyproject 的 [project.scripts]）。"""
    return main()


